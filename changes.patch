 gr00t/model/backbone/eagle_backbone.py | 34 +++++++++++++++++++++++++-
 gr00t/model/gr00t_n1.py                | 31 ++++++++++++++++++++++-
 scripts/inference_service.py           | 29 ++++++++++++++++++++++
 4 files changed, 93 insertions(+), 3 deletions(-)

diff --git a/deployment_scripts/build_engine.sh b/deployment_scripts/build_engine.sh
index 53e697a6..0a089bb3 100644
--- a/deployment_scripts/build_engine.sh
+++ b/deployment_scripts/build_engine.sh
@@ -32,7 +32,7 @@ if [ "$VIDEO_VIEWS" = "2" ]; then
 else   # one video view (default)
     MIN_LEN=80
     OPT_LEN=296
-    MAX_LEN=300
